    },
    "qqcw": {
      "label": "cloud-borne",
      "pairing": "pointer-arrays",
      "mass_ptr": "lmassptrcw_amode",
      "num_ptr": "numptrcw_amode",
      "args": ["qqcw", "dqqcwdt", "dqqcwdt_other", "dotendqqcwrn",
               "qqcwsrflx"]
    }
  },
  "convention_args": ["loffset", "num_q",
