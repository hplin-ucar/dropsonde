#!/usr/bin/env python3
"""dropsonde -- find where CAM and CAM-SIMA physics answers diverge.

Runs a dechunked single-rank CAM case and a CAM-SIMA case under gdb with
breakpoints at every CCPP scheme entry/exit listed in the SDF, dumps the
scheme arguments to disk, and reports the first divergence.

Usage:
  ./dropsonde --cam  /scratch/.../cam_case  \
              --sima /scratch/.../sima_case \
              --sdf  suite_x.xml [--steps 2] [--out dropsonde_out]

Requirements:
  - Case dirs contain bld/cesm.exe and a populated run/ directory
    (preview_namelists already run).
  - CAM:      DEBUG, GNU, NTASKS=1, NTHRDS=1, pcols = total columns,
              STOP_N covering at least --steps + 1 physics timesteps.
  - CAM-SIMA: DEBUG, GNU, single rank, STOP_N covering at least --steps
              physics timesteps.
  - gdb on PATH; both executables built with the same atmospheric_physics.

Python 3.6 compatible; stdlib only (no numpy anywhere).
"""
import argparse
import json
import os
import re
import subprocess
import sys
import xml.etree.ElementTree as ET

HERE = os.path.dirname(os.path.abspath(__file__))


def git_version():
    """Short git commit hash of the dropsonde repo, or 'unknown'."""
    try:
        out = subprocess.check_output(
            ["git", "rev-parse", "--short", "HEAD"],
            cwd=HERE, stderr=subprocess.DEVNULL)
        return out.decode().strip()
    except Exception:
        return "unknown"


def parse_sdf(path):
    """Ordered scheme names in document order; duplicates kept."""
    root = ET.parse(path).getroot()
    schemes = []
    for el in root.iter("scheme"):
        if el.text and el.text.strip():
            schemes.append(el.text.strip())
    if not schemes:
        sys.exit("error: no <scheme> entries found in {}".format(path))
    return schemes


# Optional, non-schema-changing SDF annotation that retargets a scheme's
# capture from its CCPP <scheme>_run wrapper to a shared *portable*
# subroutine that BOTH CAM and CAM-SIMA call (through different wrappers).
# The CCPP wrapper symbol exists only in the SIMA binary, so such schemes are
# otherwise reported "SIMA-only (no CAM symbol)"; the portable subroutine has
# an identical signature in both binaries and is the real comparison point.
# Convention -- an XML comment on the SAME LINE as the <scheme>:
#   <scheme>modal_aero_calcsize_ccpp</scheme>  <!-- dropsonde:portable=modal_aero_calcsize_run -->
# ElementTree drops comments (and gdb's Python 3.6 can't retain them), so the
# mapping is read by a raw-text scan that pairs each annotation with the
# <scheme> on its line.
_PORTABLE_RE = re.compile(
    r"<scheme>\s*([^<\s]+)\s*</scheme>.*?"
    r"dropsonde:portable\s*=\s*([A-Za-z]\w*)")


def parse_portable_map(path):
    """{scheme: portable_symbol} from same-line dropsonde:portable comments."""
    mapping = {}
    try:
        with open(path, errors="replace") as f:
            for ln in f:
                m = _PORTABLE_RE.search(ln)
                if m:
                    mapping[m.group(1)] = m.group(2)
    except OSError as exc:
        print("dropsonde: WARNING: could not read SDF for portable "
              "annotations: {}".format(exc))
    return mapping


_END_SUBR_RE = re.compile(r"^\s*end\s+subroutine\b", re.I)
_INTENT_RE = re.compile(r"intent\s*\(\s*(in|out|inout)\s*\)", re.I)
_IDENT_RE = re.compile(r"\s*([A-Za-z]\w*)")


def _split_top_commas(s):
    """Split on commas not inside parentheses, so array dims like (:,:) on a
    multi-name declaration stay attached to their variable."""
    parts, depth, cur = [], 0, ""
    for ch in s:
        if ch == "(":
            depth += 1
        elif ch == ")":
            depth -= 1
        if ch == "," and depth == 0:
            parts.append(cur)
            cur = ""
        else:
            cur += ch
    if cur.strip():
        parts.append(cur)
    return parts


def _subroutine_intents(path, sym):
    """{arg_lower: intent} from the Fortran declarations of subroutine `sym`
    in `path`, or None if `sym` is not defined there. Handles '&'
    continuations, '!' comments, multiple names per declaration, and
    array-dim commas. Derived-type (type()/class()) dummies are recorded too
    but are harmless -- the gdb side skips them."""
    try:
        with open(path, errors="replace") as f:
            lines = f.readlines()
    except OSError:
        return None
    sub_re = re.compile(r"^\s*subroutine\s+{}\b".format(re.escape(sym)), re.I)
    start = None
    for i, ln in enumerate(lines):
        if sub_re.match(ln):
            start = i
            break
    if start is None:
        return None
    intents = {}
    buf = ""
    for ln in lines[start:]:
        if not buf and _END_SUBR_RE.match(ln):
            break
        code = ln.split("!", 1)[0].strip()
        if code.endswith("&"):
            buf += " " + code[:-1]
            continue
        buf += " " + code
        m = _INTENT_RE.search(buf)
        if m:
            _head, sep, names = buf.partition("::")
            if sep:
                for piece in _split_top_commas(names):
                    im = _IDENT_RE.match(piece)
                    if im:
                        intents[im.group(1).lower()] = m.group(1).lower()
        buf = ""
    return intents


def parse_fortran_intents(meta_root, portable):
    """{scheme: {arg: intent}} for the portable subroutines named in
    `portable` ({scheme: symbol}), read from their Fortran intent()
    declarations. Portable subroutines have no .meta, so intents come from the
    .F90 source; keyed by SCHEME so the differ (scheme-keyed) is unchanged."""
    if not portable:
        return {}
    parsed = {sym.lower(): None for sym in portable.values()}
    for dirpath, _dirs, filenames in os.walk(meta_root):
        if all(v is not None for v in parsed.values()):
            break
        for fn in filenames:
            if not fn.lower().endswith((".f90", ".f")):
                continue
            fpath = os.path.join(dirpath, fn)
            for symlow in [k for k, v in parsed.items() if v is None]:
                got = _subroutine_intents(fpath, symlow)
                if got is not None:
                    parsed[symlow] = got
    out = {}
    for scheme, sym in portable.items():
        got = parsed.get(sym.lower())
        if got:
            out[scheme] = got
    return out


def parse_meta_intents(meta_root, schemes):
    """{scheme: {arg: intent}} for the schemes' _run phases, from CCPP
    .meta files found under meta_root. Lets the differ skip intent(out)
    args at entry (caller-side garbage) and intent(in) args at exit."""
    want = {s + "_run": s for s in schemes}
    intents = {}
    for dirpath, _dirs, filenames in os.walk(meta_root):
        for fn in filenames:
            if not fn.endswith(".meta"):
                continue
            cur_scheme = None
            cur_var = None
            try:
                f = open(os.path.join(dirpath, fn), errors="replace")
            except OSError:
                continue
            with f:
                for ln in f:
                    t = ln.strip()
                    if t.startswith("[ccpp-arg-table]"):
                        cur_scheme = None
                        cur_var = None
                    elif t.startswith("[") and t.endswith("]"):
                        cur_var = t[1:-1].strip()
                    elif "=" in t:
                        k, _, v = t.partition("=")
                        k = k.strip()
                        v = v.strip()
                        if k == "name" and cur_var is None:
                            cur_scheme = want.get(v)
                        elif k == "intent" and cur_scheme and cur_var:
                            intents.setdefault(cur_scheme, {})[
                                cur_var.lower()] = v.lower()
    return intents


def find_meta_root(sdf_abs):
    """Nearest ancestor of the SDF that holds a 'schemes' directory -- the
    atmospheric_physics root, which os.walk then searches for .meta files.
    SDFs live in either suites/ (a sibling of schemes/) or test/test_suites/,
    so a fixed number of parent hops is wrong; anchoring on schemes/ handles
    both depths. Returns None if no such ancestor exists."""
    d = os.path.dirname(sdf_abs)
    while True:
        if os.path.isdir(os.path.join(d, "schemes")):
            return d
        parent = os.path.dirname(d)
        if parent == d:
            return None
        d = parent


def launch(role, casedir, schemes, outdir, kill_after_steps, portable):
    exe = os.path.join(casedir, "bld", "cesm.exe")
    rundir = os.path.join(casedir, "run")
    if not os.path.isfile(exe):
        sys.exit("error: {} not found".format(exe))
    if not os.path.isdir(rundir):
        sys.exit("error: {} not found".format(rundir))

    roledir = os.path.join(outdir, role)
    os.makedirs(roledir, exist_ok=True)
    cfgpath = os.path.join(roledir, "config.json")
    with open(cfgpath, "w") as f:
        json.dump({"role": role, "out_dir": roledir, "schemes": schemes,
                   "kill_after_steps": kill_after_steps,
                   "portable": portable}, f, indent=1)

    env = dict(os.environ, DROPSONDE_CONFIG=cfgpath)
    # Some sites (e.g. Izumi) point PYTHONHOME/PYTHONPATH at an anaconda whose
    # stdlib version mismatches gdb's embedded Python, which then aborts with
    # "No module named 'encodings'". dropsonde's gdb side is stdlib-only, so
    # stripping them is always safe.
    env.pop("PYTHONHOME", None)
    env.pop("PYTHONPATH", None)
    logpath = os.path.join(roledir, "gdb.log")
    log = open(logpath, "w")
    proc = subprocess.Popen(
        ["gdb", "--batch", "-x", os.path.join(HERE, "dropsonde_gdb.py"), exe],
        cwd=rundir, env=env, stdout=log, stderr=subprocess.STDOUT)
    print("dropsonde: {} run launched (pid {}, log {})".format(
        role, proc.pid, logpath))
    return proc, logpath, log


def main():
    ap = argparse.ArgumentParser(
        prog="dropsonde",
        description="Locate the first CCPP scheme where CAM and CAM-SIMA "
                    "answers diverge.")
    ap.add_argument("--cam", required=True, help="CAM case scratch dir")
    ap.add_argument("--sima", required=True, help="CAM-SIMA case scratch dir")
    ap.add_argument("--sdf", required=True, help="suite definition file (XML)")
    ap.add_argument("--steps", type=int, default=1,
                    help="physics timesteps to compare (default 1: in "
                         "FPHYStest snapshot runs every timestep is "
                         "independent, so CAM step 2 vs SIMA step 1 is "
                         "decisive); CAM contributes steps+1, its first "
                         "being skipped")
    ap.add_argument("--out", default="dropsonde_out", help="dump directory")
    ap.add_argument("--meta-root", default=None,
                    help="root to search for CCPP .meta files "
                         "(default: the nearest ancestor of the SDF that "
                         "contains a schemes/ directory, i.e. the "
                         "ncar_ccpp/atmospheric_physics root)")
    ap.add_argument("--skip-cam", action="store_true",
                    help="skip the CAM gdb run and reuse existing CAM "
                         "captures in --out (useful when iterating on the "
                         "SIMA side only)")
    ap.add_argument("--skip-sima", action="store_true",
                    help="skip the SIMA gdb run and reuse existing SIMA "
                         "captures in --out")
    args = ap.parse_args()

    schemes = parse_sdf(args.sdf)
    uniq = []
    for s in schemes:
        if s not in uniq:
            uniq.append(s)
    print("dropsonde: {} scheme calls per timestep in SDF ({} unique)".format(
        len(schemes), len(uniq)))

    sdf_abs = os.path.abspath(args.sdf)
    meta_root = args.meta_root or find_meta_root(sdf_abs)
    if meta_root is None:
        meta_root = os.path.dirname(sdf_abs)
        print("dropsonde: WARNING: no schemes/ directory found above the SDF; "
              "falling back to {} -- set --meta-root if .meta files live "
              "elsewhere".format(meta_root))
    # Schemes carrying a same-line `dropsonde:portable=` SDF comment are
    # compared at their shared portable subroutine, not the CCPP wrapper.
    # Those get intents from the portable .F90 (no .meta exists for it);
    # all other schemes use .meta exactly as before.
    portable = {s: sym for s, sym in parse_portable_map(sdf_abs).items()
                if s in uniq}
    meta_schemes = [s for s in uniq if s not in portable]
    intents = parse_meta_intents(meta_root, meta_schemes)
    print("dropsonde: intents for {}/{} schemes ({} args) from .meta "
          "under {}".format(len(intents), len(meta_schemes),
                            sum(len(v) for v in intents.values()),
                            meta_root))
    if portable:
        fort = parse_fortran_intents(meta_root, portable)
        intents.update(fort)
        print("dropsonde: portable overrides ({}): {}".format(
            len(portable),
            ", ".join("{}->{}".format(s, portable[s]) for s in portable)))
        no_int = [s for s in portable if s not in fort]
        if no_int:
            print("dropsonde: WARNING: no Fortran intents found for portable "
                  "target(s): {} -- entry intent(out) args will be compared "
                  "(noisy)".format(", ".join(
                      "{}({})".format(s, portable[s]) for s in no_int)))
    if not intents:
        print("dropsonde: WARNING: no intents found; entry values of "
              "intent(out) args will be compared (noisy) -- set "
              "--meta-root")

    outdir = os.path.abspath(args.out)
    os.makedirs(outdir, exist_ok=True)
    cam_abs = os.path.abspath(args.cam)
    sima_abs = os.path.abspath(args.sima)

    # --skip-cam / --skip-sima: validate that the existing captures in --out
    # came from the same case directories the user is pointing at now.
    for skip, role, case_abs in ((args.skip_cam, "cam", cam_abs),
                                 (args.skip_sima, "sima", sima_abs)):
        if not skip:
            continue
        manifest = os.path.join(outdir, role, "manifest.json")
        if not os.path.isfile(manifest):
            sys.exit("error: --skip-{0} but no existing {0} manifest in "
                     "{1} (run without --skip-{0} first)".format(
                         role, outdir))
        suite_path = os.path.join(outdir, "suite.json")
        if os.path.isfile(suite_path):
            with open(suite_path) as f:
                prev = json.load(f)
            key = role + "_case"
            prev_case = prev.get(key)
            if prev_case and os.path.abspath(prev_case) != case_abs:
                sys.exit(
                    "error: --skip-{} but --{} points to\n"
                    "  {}\n"
                    "while the existing captures came from\n"
                    "  {}\n"
                    "These must match (re-run without --skip-{} to "
                    "recapture, or point --{} at the original case)"
                    .format(role, role, case_abs, prev_case, role, role))
        print("dropsonde: reusing existing {} captures in {}".format(
            role, outdir))

    version = git_version()
    with open(os.path.join(outdir, "suite.json"), "w") as f:
        json.dump({"schemes": schemes, "steps": args.steps,
                   "sdf": sdf_abs, "intents": intents,
                   "portable": portable,
                   "version": version,
                   "cam_case": cam_abs,
                   "sima_case": sima_abs,
                   "meta_root": meta_root}, f, indent=1)

    # CAM dumps steps+1 timesteps (its first is skipped); SIMA dumps steps.
    # The gdb side kills each run at the start of the timestep after that,
    # so STOP_N only needs to be long enough (e.g. CAM's 6-step minimum).
    runs = []
    if not args.skip_cam:
        runs.append(("cam",
                      launch("cam", args.cam, uniq, outdir, args.steps + 1,
                             portable)))
    if not args.skip_sima:
        runs.append(("sima",
                      launch("sima", args.sima, uniq, outdir, args.steps,
                             portable)))
    if runs:
        print("dropsonde: waiting for runs to finish ...")
        try:
            for role, (proc, logpath, log) in runs:
                rc = proc.wait()
                log.close()
                if rc != 0:
                    print("dropsonde: warning: {} gdb exited with rc {} "
                          "(see {})".format(role, rc, logpath))
        except KeyboardInterrupt:
            print("\ndropsonde: interrupted; terminating gdb sessions and "
                  "comparing what was captured ...")
            for _role, (proc, _, log) in runs:
                try:
                    proc.terminate()
                    proc.wait()
                except Exception:
                    pass
                finally:
                    log.close()

    sys.path.insert(0, HERE)
    import differ
    ok = differ.report(outdir, schemes, args.steps, intents)
    sys.exit(0 if ok else 1)


if __name__ == "__main__":
    main()
