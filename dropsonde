#!/usr/bin/env python3
"""dropsonde -- find where two model runs' answers diverge.

Runs both cases under gdb with breakpoints at a list of subroutine
entries/exits, dumps the subroutine arguments to disk, and reports the
first divergence.

Cross-model mode (CAM vs CAM-SIMA, the original workflow):
  ./dropsonde --cam  /scratch/.../cam_case  \
              --sima /scratch/.../sima_case \
              --sdf  suite_x.xml [--steps 2] [--out dropsonde_out]
  Comparison points come from the SDF's CCPP schemes (plus
  dropsonde:portable annotations); intents from .meta files.
  - CAM:      DEBUG, GNU, NTASKS=1, NTHRDS=1, pcols = total columns,
              STOP_N covering at least --steps + 1 physics timesteps.
  - CAM-SIMA: DEBUG, GNU, single rank, STOP_N covering at least --steps
              physics timesteps.
  - both executables built with the same atmospheric_physics.

Same-model mode (two builds of the SAME model, e.g. CAM-to-CAM after an
unexpected regression-test answer change):
  ./dropsonde --base /scratch/.../baseline_case \
              --test /scratch/.../modified_case \
              --targets cam_anchors.json [--source-root ~/CAM/src]
  Comparison points come from a dropsonde-targets-v1 subroutine list;
  identical decomposition (PE layout, chunking, threading) in both cases
  is assumed -- no dechunking or NTASKS=1 requirement. Report labels
  become base/test.

Requirements: case dirs contain bld/cesm.exe and a populated run/
directory (preview_namelists already run); gdb on PATH.

Python 3.6 compatible; stdlib only (no numpy anywhere).
"""
import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import xml.etree.ElementTree as ET

HERE = os.path.dirname(os.path.abspath(__file__))


def git_version():
    """Short git commit hash of the dropsonde repo, or 'unknown'."""
    try:
        out = subprocess.check_output(
            ["git", "rev-parse", "--short", "HEAD"],
            cwd=HERE, stderr=subprocess.DEVNULL)
        return out.decode().strip()
    except Exception:
        return "unknown"


def parse_sdf(path):
    """Ordered scheme names in document order; duplicates kept."""
    root = ET.parse(path).getroot()
    schemes = []
    for el in root.iter("scheme"):
        if el.text and el.text.strip():
            schemes.append(el.text.strip())
    if not schemes:
        sys.exit("error: no <scheme> entries found in {}".format(path))
    return schemes


# Optional, non-schema-changing SDF annotation that retargets a scheme's
# capture from its CCPP <scheme>_run wrapper to a shared *portable*
# subroutine that BOTH CAM and CAM-SIMA call (through different wrappers).
# The CCPP wrapper symbol exists only in the SIMA binary, so such schemes are
# otherwise reported "SIMA-only (no CAM symbol)"; the portable subroutine has
# an identical signature in both binaries and is the real comparison point.
# Convention -- an XML comment on the SAME LINE as the <scheme>:
#   <scheme>modal_aero_calcsize_ccpp</scheme>  <!-- dropsonde:portable=modal_aero_calcsize_run -->
# ElementTree drops comments (and gdb's Python 3.6 can't retain them), so the
# mapping is read by a raw-text scan that pairs each annotation with the
# <scheme> on its line.
_PORTABLE_RE = re.compile(
    r"<scheme>\s*([^<\s]+)\s*</scheme>.*?"
    r"dropsonde:portable\s*=\s*([A-Za-z]\w*)")


def parse_portable_map(path):
    """{scheme: portable_symbol} from same-line dropsonde:portable comments."""
    mapping = {}
    try:
        with open(path, errors="replace") as f:
            for ln in f:
                m = _PORTABLE_RE.search(ln)
                if m:
                    mapping[m.group(1)] = m.group(2)
    except OSError as exc:
        print("dropsonde: WARNING: could not read SDF for portable "
              "annotations: {}".format(exc))
    return mapping


_END_SUBR_RE = re.compile(r"^\s*end\s+subroutine\b", re.I)
_INTENT_RE = re.compile(r"intent\s*\(\s*(in|out|inout)\s*\)", re.I)
_IDENT_RE = re.compile(r"\s*([A-Za-z]\w*)")


def _split_top_commas(s):
    """Split on commas not inside parentheses, so array dims like (:,:) on a
    multi-name declaration stay attached to their variable."""
    parts, depth, cur = [], 0, ""
    for ch in s:
        if ch == "(":
            depth += 1
        elif ch == ")":
            depth -= 1
        if ch == "," and depth == 0:
            parts.append(cur)
            cur = ""
        else:
            cur += ch
    if cur.strip():
        parts.append(cur)
    return parts


def _subroutine_intents(path, sym):
    """{arg_lower: intent} from the Fortran declarations of subroutine `sym`
    in `path`, or None if `sym` is not defined there. Handles '&'
    continuations, '!' comments, multiple names per declaration, and
    array-dim commas. Derived-type (type()/class()) dummies are recorded too
    but are harmless -- the gdb side skips them."""
    try:
        with open(path, errors="replace") as f:
            lines = f.readlines()
    except OSError:
        return None
    # Prefix keywords (pure/module/...) are legal on portable subroutines;
    # match them explicitly -- a generic word-prefix would also match
    # 'end subroutine <sym>'.
    sub_re = re.compile(
        r"^\s*(?:(?:pure|elemental|impure|recursive|non_recursive|module)"
        r"\s+)*subroutine\s+{}\b".format(re.escape(sym)), re.I)
    start = None
    for i, ln in enumerate(lines):
        if sub_re.match(ln):
            start = i
            break
    if start is None:
        return None
    intents = {}
    buf = ""
    for ln in lines[start:]:
        if not buf and _END_SUBR_RE.match(ln):
            break
        code = ln.split("!", 1)[0].strip()
        if code.endswith("&"):
            buf += " " + code[:-1]
            continue
        buf += " " + code
        m = _INTENT_RE.search(buf)
        if m:
            _head, sep, names = buf.partition("::")
            if sep:
                for piece in _split_top_commas(names):
                    im = _IDENT_RE.match(piece)
                    if im:
                        intents[im.group(1).lower()] = m.group(1).lower()
        buf = ""
    return intents


def parse_fortran_intents(meta_root, portable):
    """{scheme: {arg: intent}} for the portable subroutines named in
    `portable` ({scheme: symbol}), read from their Fortran intent()
    declarations. Portable subroutines have no .meta, so intents come from the
    .F90 source; keyed by SCHEME so the differ (scheme-keyed) is unchanged."""
    if not portable:
        return {}
    parsed = {sym.lower(): None for sym in portable.values()}
    for dirpath, _dirs, filenames in os.walk(meta_root):
        if all(v is not None for v in parsed.values()):
            break
        for fn in filenames:
            if not fn.lower().endswith((".f90", ".f")):
                continue
            fpath = os.path.join(dirpath, fn)
            for symlow in [k for k, v in parsed.items() if v is None]:
                got = _subroutine_intents(fpath, symlow)
                if got is not None:
                    parsed[symlow] = got
    out = {}
    for scheme, sym in portable.items():
        got = parsed.get(sym.lower())
        if got:
            out[scheme] = got
    return out


def _capture_types(types, bad):
    """Validated {type_lower: [component paths]} from a capture-v1 types
    table (the body of a --capture spec, or a targets spec's inline
    "capture" table)."""
    if not isinstance(types, dict) or not types:
        bad("types must map derived-type names to component-path lists")
    out = {}
    for tname, paths in types.items():
        if (not isinstance(paths, list) or not paths or
                not all(isinstance(p, str) and p.strip() for p in paths)):
            bad("type {!r}: component paths must be a non-empty list of "
                "strings".format(tname))
        out[tname.strip().lower()] = [p.strip().lower().replace(" ", "")
                                      for p in paths]
    return out


def load_capture(path):
    """{derived_type_name_lower: [component paths]} from a
    dropsonde-capture-v1 JSON spec (--capture). Exits with a clear message
    on a malformed spec -- fail before the model runs, not after."""
    def bad(msg):
        sys.exit("dropsonde: invalid capture spec {}: {}".format(path, msg))
    try:
        with open(path) as f:
            spec = json.load(f)
    except (OSError, ValueError) as exc:
        bad(exc)
    if spec.get("spec") != "dropsonde-capture-v1":
        bad('missing/unknown spec tag (want "spec": "dropsonde-capture-v1")')
    return _capture_types(spec.get("types"), bad)


def load_targets(path):
    """(targets, step_sentinel, capture) from a dropsonde-targets-v1 JSON
    spec (--targets). targets is an ordered list of
    {"sub": tag, "base": symbol, "test": symbol}; a plain-string entry is
    shorthand for the same symbol on both sides, and per-side symbols exist
    for deliberate renames (refactors). "step_sentinel" names a
    once-per-timestep subroutine (default cam_run1); an optional "capture"
    table (capture-v1 types shape) travels inside the spec so a per-model
    preset is a single file. Exits with a clear message on a malformed
    spec."""
    def bad(msg):
        sys.exit("dropsonde: invalid targets spec {}: {}".format(path, msg))
    try:
        with open(path) as f:
            spec = json.load(f)
    except (OSError, ValueError) as exc:
        bad(exc)
    if spec.get("spec") != "dropsonde-targets-v1":
        bad('missing/unknown spec tag (want "spec": "dropsonde-targets-v1")')
    raw = spec.get("targets")
    if not isinstance(raw, list) or not raw:
        bad("targets must be a non-empty list")
    targets = []
    seen = set()
    for i, t in enumerate(raw):
        if isinstance(t, str):
            t = {"sub": t}
        if not isinstance(t, dict) or not isinstance(t.get("sub"), str) \
                or not t["sub"].strip():
            bad("target {}: need a subroutine name string or an object "
                'with "sub"'.format(i))
        unknown = set(t) - {"sub", "base", "test"}
        if unknown:
            bad("target {!r}: unknown key(s): {}".format(
                t["sub"], ", ".join(sorted(unknown))))
        sub = t["sub"].strip()
        if sub in seen:
            bad("duplicate target {!r}".format(sub))
        seen.add(sub)
        targets.append({"sub": sub,
                        "base": (t.get("base") or sub).strip(),
                        "test": (t.get("test") or sub).strip()})
    sentinel = spec.get("step_sentinel", "cam_run1")
    if not isinstance(sentinel, str) or not sentinel.strip():
        bad("step_sentinel must be a subroutine name")
    capture = {}
    if spec.get("capture") is not None:
        capture = _capture_types(spec["capture"], bad)
    return targets, sentinel.strip(), capture


def parse_meta_intents(meta_root, schemes):
    """{scheme: {arg: intent}} for the schemes' _run phases, from CCPP
    .meta files found under meta_root. Lets the differ skip intent(out)
    args at entry (caller-side garbage) and intent(in) args at exit."""
    want = {s + "_run": s for s in schemes}
    intents = {}
    for dirpath, _dirs, filenames in os.walk(meta_root):
        for fn in filenames:
            if not fn.endswith(".meta"):
                continue
            cur_scheme = None
            cur_var = None
            try:
                f = open(os.path.join(dirpath, fn), errors="replace")
            except OSError:
                continue
            with f:
                for ln in f:
                    t = ln.strip()
                    if t.startswith("[ccpp-arg-table]"):
                        cur_scheme = None
                        cur_var = None
                    elif t.startswith("[") and t.endswith("]"):
                        cur_var = t[1:-1].strip()
                    elif "=" in t:
                        k, _, v = t.partition("=")
                        k = k.strip()
                        v = v.strip()
                        if k == "name" and cur_var is None:
                            cur_scheme = want.get(v)
                        elif k == "intent" and cur_scheme and cur_var:
                            intents.setdefault(cur_scheme, {})[
                                cur_var.lower()] = v.lower()
    return intents


def find_meta_root(sdf_abs):
    """Nearest ancestor of the SDF that holds a 'schemes' directory -- the
    atmospheric_physics root, which os.walk then searches for .meta files.
    SDFs live in either suites/ (a sibling of schemes/) or test/test_suites/,
    so a fixed number of parent hops is wrong; anchoring on schemes/ handles
    both depths. Returns None if no such ancestor exists."""
    d = os.path.dirname(sdf_abs)
    while True:
        if os.path.isdir(os.path.join(d, "schemes")):
            return d
        parent = os.path.dirname(d)
        if parent == d:
            return None
        d = parent


def launch(role, casedir, schemes, outdir, kill_after_steps, portable,
           capture, step_sentinel, const_probe):
    exe = os.path.join(casedir, "bld", "cesm.exe")
    rundir = os.path.join(casedir, "run")
    if not os.path.isfile(exe):
        sys.exit("error: {} not found".format(exe))
    if not os.path.isdir(rundir):
        sys.exit("error: {} not found".format(rundir))

    roledir = os.path.join(outdir, role)
    os.makedirs(roledir, exist_ok=True)
    cfgpath = os.path.join(roledir, "config.json")
    with open(cfgpath, "w") as f:
        json.dump({"role": role, "out_dir": roledir, "schemes": schemes,
                   "kill_after_steps": kill_after_steps,
                   "portable": portable, "capture": capture,
                   "step_sentinel": step_sentinel,
                   "const_probe": const_probe}, f, indent=1)

    env = dict(os.environ, DROPSONDE_CONFIG=cfgpath)
    # Some sites (e.g. Izumi) point PYTHONHOME/PYTHONPATH at an anaconda whose
    # stdlib version mismatches gdb's embedded Python, which then aborts with
    # "No module named 'encodings'". dropsonde's gdb side is stdlib-only, so
    # stripping them is always safe.
    env.pop("PYTHONHOME", None)
    env.pop("PYTHONPATH", None)
    logpath = os.path.join(roledir, "gdb.log")
    log = open(logpath, "w")
    proc = subprocess.Popen(
        ["gdb", "--batch", "-x", os.path.join(HERE, "dropsonde_gdb.py"), exe],
        cwd=rundir, env=env, stdout=log, stderr=subprocess.STDOUT)
    print("dropsonde: {} run launched (pid {}, log {})".format(
        role, proc.pid, logpath))
    return proc, logpath, log


def main():
    ap = argparse.ArgumentParser(
        prog="dropsonde",
        description="Locate the first subroutine where two model runs' "
                    "answers diverge. Cross-model mode (--cam/--sima/--sdf) "
                    "compares CAM against CAM-SIMA at the CCPP schemes of "
                    "an SDF; same-model mode (--base/--test/--targets) "
                    "compares two builds of the SAME model at an explicit "
                    "subroutine list.")
    ap.add_argument("--cam", help="CAM case scratch dir (cross-model mode)")
    ap.add_argument("--sima", help="CAM-SIMA case scratch dir "
                                   "(cross-model mode)")
    ap.add_argument("--sdf", help="suite definition file (XML; "
                                  "cross-model mode)")
    ap.add_argument("--base", help="reference case scratch dir "
                                   "(same-model mode)")
    ap.add_argument("--test", help="modified case scratch dir "
                                   "(same-model mode)")
    ap.add_argument("--targets", default=None, metavar="SPEC.json",
                    help="dropsonde-targets-v1 subroutine list (same-model "
                         "mode): the comparison points, an optional "
                         "step_sentinel, an optional capture table; see "
                         "docs/targets_example.json")
    ap.add_argument("--source-root", default=None,
                    help="same-model mode: source tree searched for the "
                         "targets' Fortran intent() declarations, so "
                         "intent(out) args are not compared at entry; "
                         "without it those comparisons are noisy")
    ap.add_argument("--steps", type=int, default=1,
                    help="timesteps to compare (default 1). Cross-model "
                         "FPHYStest snapshot runs are decisive at 1 (every "
                         "timestep is independent; CAM contributes "
                         "steps+offset, its first being skipped)")
    ap.add_argument("--out", default="dropsonde_out", help="dump directory")
    ap.add_argument("--meta-root", default=None,
                    help="root to search for CCPP .meta files "
                         "(default: the nearest ancestor of the SDF that "
                         "contains a schemes/ directory, i.e. the "
                         "ncar_ccpp/atmospheric_physics root)")
    ap.add_argument("--skip-cam", action="store_true",
                    help="skip the CAM gdb run and reuse existing CAM "
                         "captures in --out (useful when iterating on the "
                         "SIMA side only)")
    ap.add_argument("--skip-sima", action="store_true",
                    help="skip the SIMA gdb run and reuse existing SIMA "
                         "captures in --out")
    ap.add_argument("--skip-base", action="store_true",
                    help="same-model mode: reuse existing base captures")
    ap.add_argument("--skip-test", action="store_true",
                    help="same-model mode: reuse existing test captures")
    ap.add_argument("--realign", default=None, metavar="SPEC.json",
                    help="constituent-index realignment spec for portable "
                         "subroutines called from different index "
                         "conventions (e.g. docs/realign_mam.json for the "
                         "MAM aerosol routines); copied to <out>/"
                         "realign.json, where the differ reads it")
    ap.add_argument("--capture", default=None, metavar="SPEC.json",
                    help="derived-type capture spec: JSON mapping derived-"
                         "type names to the component paths worth comparing "
                         "(e.g. element_t -> state%%v); matching derived-"
                         "type dummies are expanded into per-component "
                         "pseudo-args instead of being skipped. Needed for "
                         "non-CCPP code like the SE dycore (see docs/"
                         "capture_se_dycore.json). Debug (-O0) builds only")
    ap.add_argument("--step-offset", type=int, default=None, metavar="N",
                    help="reference-side timestep pairing with step t is "
                         "t+N (default 1 with --sdf: FPHYStest snapshot "
                         "runs, where CAM's first step is skipped; default "
                         "0 with --targets: two builds running freely from "
                         "identical initial conditions)")
    args = ap.parse_args()

    # Mode resolution. role_c is the reference side (historically CAM),
    # role_s the side under test (historically CAM-SIMA); the names become
    # the <out> subdirectories and every report label.
    targets_mode = args.targets is not None
    if targets_mode:
        if not (args.base and args.test):
            sys.exit("error: --targets requires --base and --test")
        if args.cam or args.sima or args.sdf or args.meta_root:
            sys.exit("error: --cam/--sima/--sdf/--meta-root are cross-model "
                     "options; with --targets use --base/--test/"
                     "--source-root")
        if args.skip_cam or args.skip_sima:
            sys.exit("error: use --skip-base/--skip-test with --targets")
        role_c, role_s = "base", "test"
        case_c, case_s = args.base, args.test
        skip_c, skip_s = args.skip_base, args.skip_test
    else:
        if not (args.cam and args.sima and args.sdf):
            sys.exit("error: need --cam, --sima and --sdf (cross-model "
                     "mode) or --base, --test and --targets (same-model "
                     "mode)")
        if args.base or args.test or args.source_root:
            sys.exit("error: --base/--test/--source-root are same-model "
                     "options; with --sdf use --cam/--sima/--meta-root")
        if args.skip_base or args.skip_test:
            sys.exit("error: use --skip-cam/--skip-sima with --sdf")
        role_c, role_s = "cam", "sima"
        case_c, case_s = args.cam, args.sima
        skip_c, skip_s = args.skip_cam, args.skip_sima
    offset = args.step_offset
    if offset is None:
        offset = 0 if targets_mode else 1
    if offset < 0:
        sys.exit("error: --step-offset must be >= 0")

    capture_inline = {}
    if targets_mode:
        targets, sentinel, capture_inline = load_targets(args.targets)
        spec_abs = os.path.abspath(args.targets)
        spec_key = "targets"
        schemes = [t["sub"] for t in targets]
        uniq = schemes                     # load_targets rejects duplicates
        print("dropsonde: {} target subroutines (sentinel: {})".format(
            len(uniq), sentinel))
        # Per-side breakpoint symbols: identity unless the spec renames a
        # side (a refactor). The suite-level portable map keeps only genuine
        # test-side retargets, for report labels.
        portable_c = {t["sub"]: t["base"] for t in targets}
        portable_s = {t["sub"]: t["test"] for t in targets}
        suite_portable = {t["sub"]: t["test"] for t in targets
                          if t["test"] != t["sub"]}
        renamed = [t for t in targets
                   if t["base"] != t["sub"] or t["test"] != t["sub"]]
        if renamed:
            print("dropsonde: per-side symbols: {}".format(", ".join(
                "{} (base={}, test={})".format(t["sub"], t["base"], t["test"])
                for t in renamed)))
        intents = {}
        if args.source_root:
            source_root = os.path.abspath(args.source_root)
            intents = parse_fortran_intents(source_root, portable_s)
            print("dropsonde: intents for {}/{} targets ({} args) from "
                  "Fortran source under {}".format(
                      len(intents), len(uniq),
                      sum(len(v) for v in intents.values()), source_root))
            no_int = [s for s in uniq if s not in intents]
            if no_int:
                print("dropsonde: WARNING: no Fortran intents found for: {} "
                      "-- entry intent(out) args will be compared (noisy)"
                      .format(", ".join(no_int)))
        else:
            source_root = None
            print("dropsonde: WARNING: no --source-root; entry values of "
                  "intent(out) args will be compared (noisy)")
        meta_root = None
    else:
        sentinel = "cam_run1"
        schemes = parse_sdf(args.sdf)
        uniq = []
        for s in schemes:
            if s not in uniq:
                uniq.append(s)
        print("dropsonde: {} scheme calls per timestep in SDF ({} unique)"
              .format(len(schemes), len(uniq)))

        spec_abs = os.path.abspath(args.sdf)
        spec_key = "sdf"
        source_root = None
        meta_root = args.meta_root or find_meta_root(spec_abs)
        if meta_root is None:
            meta_root = os.path.dirname(spec_abs)
            print("dropsonde: WARNING: no schemes/ directory found above the "
                  "SDF; falling back to {} -- set --meta-root if .meta files "
                  "live elsewhere".format(meta_root))
        # Schemes carrying a same-line `dropsonde:portable=` SDF comment are
        # compared at their shared portable subroutine, not the CCPP wrapper.
        # Those get intents from the portable .F90 (no .meta exists for it);
        # all other schemes use .meta exactly as before.
        portable = {s: sym for s, sym in parse_portable_map(spec_abs).items()
                    if s in uniq}
        portable_c = portable_s = suite_portable = portable
        meta_schemes = [s for s in uniq if s not in portable]
        intents = parse_meta_intents(meta_root, meta_schemes)
        print("dropsonde: intents for {}/{} schemes ({} args) from .meta "
              "under {}".format(len(intents), len(meta_schemes),
                                sum(len(v) for v in intents.values()),
                                meta_root))
        if portable:
            fort = parse_fortran_intents(meta_root, portable)
            intents.update(fort)
            print("dropsonde: portable overrides ({}): {}".format(
                len(portable),
                ", ".join("{}->{}".format(s, portable[s]) for s in portable)))
            no_int = [s for s in portable if s not in fort]
            if no_int:
                print("dropsonde: WARNING: no Fortran intents found for "
                      "portable target(s): {} -- entry intent(out) args will "
                      "be compared (noisy)".format(", ".join(
                          "{}({})".format(s, portable[s]) for s in no_int)))
        if not intents:
            print("dropsonde: WARNING: no intents found; entry values of "
                  "intent(out) args will be compared (noisy) -- set "
                  "--meta-root")

    # A --capture file merges over (and overrides) any capture table carried
    # inside a targets spec.
    capture = dict(capture_inline)
    if args.capture:
        capture.update(load_capture(args.capture))
    if capture:
        print("dropsonde: capture spec: {} derived type(s): {}".format(
            len(capture),
            ", ".join("{} ({} paths)".format(t, len(p))
                      for t, p in sorted(capture.items()))))

    outdir = os.path.abspath(args.out)
    os.makedirs(outdir, exist_ok=True)
    cam_abs = os.path.abspath(case_c)
    sima_abs = os.path.abspath(case_s)

    # --realign: validate up front (differ.load_realign exits with a clear
    # message on a bad spec -- fail before the model runs, not after) and
    # copy into --out, where the differ reads it. Editing <out>/realign.json
    # and re-running `python3 differ.py <out>` iterates without re-running
    # the models. Without --realign, drop any stale copy from a prior run.
    sys.path.insert(0, HERE)
    import differ
    realign_dest = os.path.join(outdir, "realign.json")
    realign_abs = None
    if args.realign:
        realign_abs = os.path.abspath(args.realign)
        differ.load_realign(realign_abs)
        if realign_abs != realign_dest:
            shutil.copyfile(realign_abs, realign_dest)
    elif os.path.isfile(realign_dest):
        os.remove(realign_dest)
        print("dropsonde: removed stale {} (no --realign given)".format(
            realign_dest))

    # --skip-*: validate that the existing captures in --out came from the
    # same case directory, spec file, and --steps the user is pointing at
    # now -- suite.json is rewritten below with the NEW values, so a
    # mismatch would silently relabel stale captures.
    for skip, role, case_abs in ((skip_c, role_c, cam_abs),
                                 (skip_s, role_s, sima_abs)):
        if not skip:
            continue
        manifest = os.path.join(outdir, role, "manifest.json")
        if not os.path.isfile(manifest):
            sys.exit("error: --skip-{0} but no existing {0} manifest in "
                     "{1} (run without --skip-{0} first)".format(
                         role, outdir))
        suite_path = os.path.join(outdir, "suite.json")
        if os.path.isfile(suite_path):
            with open(suite_path) as f:
                prev = json.load(f)
            checks = ((role + "_case", case_abs, "--" + role),
                      (spec_key, spec_abs, "--" + spec_key),
                      ("steps", args.steps, "--steps"),
                      ("step_offset", offset, "--step-offset"))
            for key, now, flag in checks:
                prev_val = prev.get(key)
                if prev_val is None:
                    continue
                if key not in ("steps", "step_offset"):
                    prev_val = os.path.abspath(prev_val)
                if prev_val != now:
                    sys.exit(
                        "error: --skip-{} but {} is\n"
                        "  {}\n"
                        "while the existing captures came from\n"
                        "  {}\n"
                        "These must match (re-run without --skip-{} to "
                        "recapture, or restore the original {})"
                        .format(role, flag, now, prev_val, role, flag))
        print("dropsonde: reusing existing {} captures in {}".format(
            role, outdir))

    version = git_version()
    suite = {"schemes": schemes, "steps": args.steps,
             "step_offset": offset,
             "roles": {"c": role_c, "s": role_s},
             "step_sentinel": sentinel,
             spec_key: spec_abs, "intents": intents,
             "portable": suite_portable,
             "capture": capture,
             "realign": realign_abs,
             "version": version,
             role_c + "_case": cam_abs,
             role_s + "_case": sima_abs}
    if targets_mode:
        suite["source_root"] = source_root
    else:
        suite["meta_root"] = meta_root
    with open(os.path.join(outdir, "suite.json"), "w") as f:
        json.dump(suite, f, indent=1)

    # The reference side dumps steps+offset timesteps (step t pairs with
    # step t+offset); the test side dumps steps. The gdb side kills each
    # run at the start of the timestep after that, so STOP_N only needs to
    # be long enough (e.g. CAM's 6-step minimum).
    # Constituent-name probe: model-specific in cross-model mode; same-model
    # runs try both known layouts and skip gracefully (e.g. CTSM has none).
    probe_c = "auto" if targets_mode else "cnst_name"
    probe_s = "auto" if targets_mode else "const_props"
    runs = []
    if not skip_c:
        runs.append((role_c,
                      launch(role_c, case_c, uniq, outdir,
                             args.steps + offset, portable_c,
                             capture, sentinel, probe_c)))
    if not skip_s:
        runs.append((role_s,
                      launch(role_s, case_s, uniq, outdir, args.steps,
                             portable_s, capture, sentinel, probe_s)))
    if runs:
        print("dropsonde: waiting for runs to finish ...")
        try:
            for role, (proc, logpath, log) in runs:
                rc = proc.wait()
                log.close()
                if rc != 0:
                    print("dropsonde: warning: {} gdb exited with rc {} "
                          "(see {})".format(role, rc, logpath))
        except KeyboardInterrupt:
            print("\ndropsonde: interrupted; terminating gdb sessions and "
                  "comparing what was captured ...")
            for _role, (proc, _, log) in runs:
                try:
                    proc.terminate()
                    proc.wait()
                except Exception:
                    pass
                finally:
                    log.close()

    ok = differ.report(outdir, schemes, args.steps, intents)
    sys.exit(0 if ok else 1)


if __name__ == "__main__":
    main()
